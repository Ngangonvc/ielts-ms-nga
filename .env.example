# ========================================================================
# IELTS Ms Nga - Environment Variables Template
# ========================================================================

# Application Port
PORT=5000

# Secret key used for signing JWT tokens (min 32 characters)
JWT_SECRET=super_secure_random_jwt_secret_key_ielts_ms_nga_2026_exam

# Database Configuration:
# By default, sql.js (local file database) is used in ./data/classroom.db with zero external dependencies.
DATA_DIR=./data
DB_FILE=./data/classroom.db

# Optional Supabase / PostgreSQL Database Connection (if using cloud Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# File Uploads Directory
UPLOADS_DIR=./uploads
